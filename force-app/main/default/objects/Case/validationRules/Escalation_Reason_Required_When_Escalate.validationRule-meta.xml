<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Escalation_Reason_Required_When_Escalate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
     IsEscalated  = TRUE,
    ISBLANK(TEXT(Escalation_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>Escalation_Reason__c</errorDisplayField>
    <errorMessage>Escalation Reason is mandatory when a Case is marked as Escalated.</errorMessage>
</ValidationRule>
